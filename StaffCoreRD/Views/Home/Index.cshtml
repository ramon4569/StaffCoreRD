@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center py-5 mb-4" style="background: linear-gradient(135deg, #0d6efd, #0a58ca); border-radius: 12px; color: white;">
    <h1 class="display-4 fw-bold">StaffCore RD</h1>
    <p class="lead mb-0">Sistema de gestión de personal para empresas dominicanas</p>
</div>

@if (User.Identity.IsAuthenticated)
{
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="fs-1 mb-3">👥</div>
                    <h5 class="card-title">Personal</h5>
                    <p class="card-text text-muted">Consulta, edita y administra los empleados registrados.</p>
                    <a asp-controller="Staff" asp-action="Index" class="btn btn-primary">Ver listado</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="fs-1 mb-3">📊</div>
                    <h5 class="card-title">Resumen por departamento</h5>
                    <p class="card-text text-muted">Estadísticas de nómina agrupadas por departamento.</p>
                    <a asp-controller="Staff" asp-action="Reporte" class="btn btn-outline-primary">Ver resumen</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="fs-1 mb-3">➕</div>
                    <h5 class="card-title">Nuevo empleado</h5>
                    <p class="card-text text-muted">Registra un nuevo colaborador en el sistema.</p>
                    <a asp-controller="Staff" asp-action="Create" class="btn btn-outline-primary">Agregar</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center">
        <p class="fs-5 text-muted">Inicia sesión para gestionar el personal de tu empresa.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary me-2">Iniciar sesión</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary">Registrarse</a>
    </div>
}