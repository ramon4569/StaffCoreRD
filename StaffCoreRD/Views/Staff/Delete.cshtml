@model StaffCoreRD.Models.Staff
@{
    ViewData["Title"] = "Eliminar empleado";
}

<h2 class="mb-4 text-danger">Eliminar empleado</h2>

<p>¿Estás seguro de que deseas eliminar este empleado? Esta acción no se puede deshacer.</p>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4">Cédula</dt>
            <dd class="col-sm-8">@Model.Cedula</dd>

            <dt class="col-sm-4">Cargo</dt>
            <dd class="col-sm-8">@Model.Cargo</dd>

            <dt class="col-sm-4">Departamento</dt>
            <dd class="col-sm-8">@Model.Departamento</dd>

            <dt class="col-sm-4">Salario</dt>
            <dd class="col-sm-8">@Model.Salario.ToString("C2")</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>