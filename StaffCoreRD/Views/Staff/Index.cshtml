@model List<StaffCoreRD.Models.Staff>
@{
    ViewData["Title"] = "Personal";
    var totalNomina = Model.Sum(s => s.Salario);
}

<h2 class="mb-4">Personal</h2>

@if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
{
    <a asp-action="Create" class="btn btn-primary mb-3">+ Nuevo empleado</a>
}

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Cédula</th>
            <th>Cargo</th>
            <th>Departamento</th>
            <th>Salario</th>
            <th>Fecha ingreso</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Nombre</td>
                <td>@s.Cedula</td>
                <td>@s.Cargo</td>
                <td>@s.Departamento</td>
                <td>@s.Salario.ToString("C2")</td>
                <td>@s.FechaIngreso.ToShortDateString()</td>
                <td>
                    @if (s.Activo)
                    {
                        <span class="badge bg-success">Sí</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
                <td>
                    @if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
                    {
                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    }
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="table-light fw-bold">
            <td colspan="4" class="text-end">Total nómina:</td>
            <td colspan="4">@totalNomina.ToString("C2")</td>
        </tr>
    </tfoot>
</table>