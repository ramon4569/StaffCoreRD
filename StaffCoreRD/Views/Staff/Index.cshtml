@model List<StaffCoreRD.Models.Staff>
@{
    ViewData["Title"] = "Personal";
    var totalNomina = Model.Sum(s => s.Salario);
}

<h2 class="mb-4">Personal</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    @if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
    {
        <a asp-action="Create" class="btn btn-primary">+ Nuevo empleado</a>
    }
    else
    {
        <span></span>
    }
    <a asp-action="Reporte" class="btn btn-outline-dark">Ver resumen por departamento</a>
</div>

<div class="mb-3">
    <input type="text" id="buscador" class="form-control" placeholder="Buscar por nombre, cédula, cargo o departamento..." />
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Cédula</th>
            <th>Cargo</th>
            <th>Departamento</th>
            <th>Salario</th>
            <th>Fecha ingreso</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@s.Id" class="text-decoration-none">@s.Nombre</a>
                </td>
                <td>@s.Cedula</td>
                <td>@s.Cargo</td>
                <td>@s.Departamento</td>
                <td>@s.Salario.ToString("C2")</td>
                <td>@s.FechaIngreso.ToShortDateString()</td>
                <td>
                    @if (s.Activo)
                    {
                        <span class="badge bg-success">Sí</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                    @if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
                    {
                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    }
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="table-light fw-bold">
            <td colspan="4" class="text-end">Total nómina:</td>
            <td colspan="4">@totalNomina.ToString("C2")</td>
        </tr>
    </tfoot>
</table>

@section Scripts {
    <script>
        document.getElementById('buscador').addEventListener('input', function () {
            const filtro = this.value.toLowerCase();
            const filas = document.querySelectorAll('table tbody tr');

            filas.forEach(fila => {
                const texto = fila.innerText.toLowerCase();
                fila.style.display = texto.includes(filtro) ? '' : 'none';
            });
        });
    </script>
}